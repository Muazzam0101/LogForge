# LogForge Backend Environment Configuration
PROJECT_NAME="LogForge ULPF Core Engine"
VERSION="0.1.0"
DEBUG=False

# MySQL Connection URL (Default: local MySQL 8.0 instance)
DATABASE_URL=mysql+pymysql://root:admin@localhost:3306/logforge

# Alternative: PostgreSQL Connection URL
# DATABASE_URL=postgresql+psycopg://logforge:logforge@localhost:5432/logforge

# Alternative: SQLite for isolated zero-dependency testing
# DATABASE_URL=sqlite:///./logforge.db

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=False

# Blockchain Integrity Anchoring (Optional / Modular)
# Set to false for pure offline / air-gapped deployments without blockchain node
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_NETWORK=local-evm
