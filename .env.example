# LogForge Environment Configuration

# Frontend (Next.js)
NEXT_PUBLIC_ULPF_API_URL=http://127.0.0.1:8000

# Backend (FastAPI Database - MySQL 8.0 / PostgreSQL / SQLite)
DATABASE_URL=mysql+pymysql://root:admin@localhost:3306/logforge
# DATABASE_URL=postgresql+psycopg://logforge:logforge@localhost:5432/logforge
# DATABASE_URL=sqlite:///./logforge.db

# OpenSearch Distributed Search & Analytics
OPENSEARCH_ENABLED=false
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=logforge-events
OPENSEARCH_BULK_SIZE=500
OPENSEARCH_REFRESH_INTERVAL=1s

# Apache Kafka Distributed Streaming
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_LOG_TOPIC=logforge.raw-events
KAFKA_DLQ_TOPIC=logforge.dead-letter
KAFKA_CONSUMER_GROUP=logforge-ulpf-workers
KAFKA_BATCH_SIZE=100
KAFKA_COMPRESSION=snappy

# ULPF Worker Scalability & Performance Tuning
ULPF_BATCH_SIZE=100
ULPF_WORKER_CONCURRENCY=1
PERFORMANCE_METRICS_ENABLED=true
